{
  "manifest_version": 3,
  "name": "Alethech Portable Memory",
  "version": "0.9.1",
  "description": "Guarda y cifra conversaciones de IA como memoria port\u00e1til .aleth. Sin cuenta, sin red, sin servidor.",
  "action": {
    "default_title": "Alethech Memory",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://chat.deepseek.com/*",
        "https://www.deepseek.com/*",
        "https://chatglm.cn/*",
        "https://chat.z.ai/*",
        "https://chatglm.net/*",
        "https://x.com/*",
        "https://grok.com/*",
        "https://grok.x.ai/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://you.com/*",
        "https://chat.you.com/*",
        "https://www.mistral.ai/*",
        "https://chat.mistral.ai/*",
        "https://lechat.mistral.ai/*",
        "https://chat.mistral.ai/*",
        "https://huggingface.co/chat/*",
        "https://cohere.com/*",
        "https://dashboard.cohere.com/*",
        "https://kimi.moonshot.cn/*",
        "https://kimi.moonshot.cn/*",
        "https://www.moonshot.cn/*",
        "https://chat.qwen.ai/*",
        "https://tongyi.aliyun.com/*",
        "https://qianwen.aliyun.com/*",
        "https://chat.baidu.com/*",
        "https://chat.wenxin.baidu.com/*",
        "https://yiyan.baidu.com/*",
        "https://chat.sensetime.com/*",
        "https://chat.minimaxi.com/*",
        "https://www.minimaxi.com/*",
        "https://character.ai/*",
        "https://beta.character.ai/*",
        "https://www.phind.com/*",
        "https://phind.com/*",
        "https://www.phind.com/*",
        "https://duckduckgo.com/chat/*",
        "https://chat.duckduckgo.com/*",
        "https://www.cursor.com/*",
        "https://cursor.sh/*",
        "https://github.com/copilot/*",
        "https://alethech.alicelabs.site/*"
      ],
      "js": [
        "brain.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/scrypt-js.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}