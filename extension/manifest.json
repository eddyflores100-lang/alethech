{
  "manifest_version": 3,
  "name": "Alethech Portable Memory",
  "version": "0.1.0",
  "description": "Open and verify encrypted .aleth AI memory locally.",
  "action": {
    "default_title": "Alethech Memory",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
