{
  "manifest_version": 3,
  "name": "Alethech Portable Memory",
  "version": "0.9.1",
  "description": "Guarda y cifra conversaciones de IA como memoria port\u00e1til .aleth. Sin cuenta, sin red, sin servidor.",
  "action": {
    "default_title": "Alethech Memory",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://alethech.alicelabs.site/*"
      ],
      "js": [
        "brain.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/scrypt-js.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}